+        self._columns = list(columns)
+
+    @builder
+    def replace_table(self, current_table: Table | None, new_table: Table | None) -> Self:
+        self.args = [
+            (
+                param.replace_table(current_table, new_table)
+                if callable(getattr(type(param), "replace_table", None))
+                else (new_table if param == current_table else param)
+            )
+            for param in self.args
+        ]
+
+    def get_special_params_sql(self, **kwargs: Any) -> Any:
+        pass
+
+    @staticmethod
+    def get_arg_sql(arg: Any, **kwargs: Any) -> str:
+        return arg.get_sql(with_alias=False, **kwargs) if hasattr(arg, "get_sql") else str(arg)
+
+    def get_function_sql(self, **kwargs: Any) -> str:
+        special_params_sql = self.get_special_params_sql(**kwargs)
+        func_kwargs = dict(kwargs)
+        func_kwargs["subquery"] = True
+        func_kwargs["with_alias"] = False
+
+        return "{name}({args}{special})".format(
+            name=self.name,
+            args=",".join(
+                (p.get_sql(**func_kwargs) if hasattr(p, "get_sql") else self.get_arg_sql(p, **func_kwargs))
+                for p in self.args
+            ),
+            special=(" " + special_params_sql) if special_params_sql else "",
+        )
+
+    def get_table_name(self) -> str:
+        return self.alias or self.name
+
+    def get_sql(self, **kwargs: Any) -> str:
+        # Ignore subquery flag: TableFunction renders as the call itself,
+        # followed by its alias when it has one, rather than as a parenthesised subquery
+        func_kwargs = dict(kwargs)
+        func_kwargs.pop("subquery", None)
+        sql = self.get_function_sql(**func_kwargs)
+        if self._with_ordinality:
+            sql = f"{sql} WITH ORDINALITY"
+
+        if self.alias is not None:
+            as_keyword = kwargs.get("as_keyword", False)
+            quote_char = kwargs.get("quote_char")
+            alias_quote_char = kwargs.get("alias_quote_char")
+            alias_formatted = format_quotes(self.alias, alias_quote_char or quote_char)
+            if self._columns:
+                cols_formatted = ",".join(format_quotes(c, quote_char) for c in self._columns)
+                alias_formatted = f"{alias_formatted}({cols_formatted})"
+            sql = f"{sql}{' AS ' if as_keyword else ' '}{alias_formatted}"
+
+        return sql
+
+    def __str__(self) -> str:
+        return self.get_sql(quote_char='"')
+
+    def __repr__(self) -> str:
+        return self.__str__()
